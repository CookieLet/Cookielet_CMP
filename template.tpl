scenarios:
- name: Sets default consent, developer ID and loads consent.js
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onSuccess();
    });

    runCode(mockData);

    assertApi('gtagSet').wasCalledWith({
      ads_data_redaction: false,
      url_passthrough: false,
      'developer_id.dNWNkMD': true
    });
    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 2000
    });
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Restores accept_all from URL-encoded cmp_consent cookie
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onSuccess();
    });
    mock('getCookieValues', function (name) {
      return name === 'cmp_consent' ? ['%7B%22status%22%3A%22accept_all%22%7D'] : [];
    });

    runCode(mockData);

    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'granted',
      analytics_storage: 'granted',
      functionality_storage: 'granted',
      personalization_storage: 'granted',
      security_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted'
    });
- name: Restores deny_all from cmp_consent cookie
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onSuccess();
    });
    mock('getCookieValues', function (name) {
      return name === 'cmp_consent' ? ['{"status":"deny_all"}'] : [];
    });

    runCode(mockData);

    assertApi('updateConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
- name: Does not update consent when no cookie is set
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onSuccess();
    });
    mock('getCookieValues', function (name) {
      return [];
    });

    runCode(mockData);

    assertApi('updateConsentState').wasNotCalled();
- name: Reports failure when consent.js fails to load
  code: |-
    mock('injectScript', function (url, onSuccess, onFailure) {
      onFailure();
    });

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
